# Copy this file and edit the values:  cp .env.example .env
# (.env is ignored by git; do not commit your local paths.)

# Absolute path to your vault root on the host. `~` is not expanded.
VAULT_PATH=/path/to/vault

# Subfolder of the vault to publish. It is mounted at /vault-input/<name>,
# which must stay relative to the vault root so wikilinks resolve.
VAULT_SUBDIR=notes

# Public domain used for canonical links and sitemaps.
BASE_URL=notes.example.com

# Site title shown on the home page and in the header.
SITE_TITLE=Appunti Uni

# Host port the nginx container listens on.
HOST_PORT=8080
